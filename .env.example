# Morrow starts in local-only development mode.
MORROW_ENV=development
MORROW_DATA_DIR=.morrow
MORROW_BIND_HOST=127.0.0.1
MORROW_WEB_PORT=3000
MORROW_API_PORT=4100
MORROW_EXTERNAL_NETWORK=disabled

# ── Model providers (server-side only; never sent to the browser) ────────────
# Set only the keys you use. Do NOT commit real values; copy to a local .env.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# Generic OpenAI-compatible gateway:
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=
# Local, fully private inference (opt-in): point at a running Ollama server.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1

# Deterministic mock provider for development and tests (no network, no keys).
# MOCK_PROVIDER=true

# ── Hosted account pairing (optional; unset = fully local, no change) ────────
# When unset, /api/pairing/status always reports "unpaired" and
# /api/pairing/redeem is unavailable. Set to a running services/hosted-api
# instance to enable account/billing pairing (Plans/generic-sprouting-dragon.md
# Phase 4). Local dev value: http://127.0.0.1:8787
# MORROW_HOSTED_API_URL=

# ── Performance and durability tuning (optional; defaults are the fast path) ─
# Durability of committed SQLite writes. Under WAL the default NORMAL fsyncs at
# checkpoints rather than every commit: a Morrow crash loses nothing, only an OS
# crash or power loss can drop the most recent commits, and the database is
# never corrupted. Set FULL to fsync on every commit (~7x slower writes; this is
# also what an existing install got on its very first run, before the mode was
# set explicitly).
# MORROW_SQLITE_SYNCHRONOUS=NORMAL
#
# How often streamed assistant text is written through to durable storage, in
# milliseconds. 0 restores a durable write per provider chunk.
# MORROW_STREAM_FLUSH_MS=60
#
# Build the exact OpenAI tokenizer at boot instead of inside the first turn that
# needs it. Costs ~66MB of heap; only runs when an OpenAI-family provider is
# configured. Set to true to always defer it.
# MORROW_DISABLE_TOKENIZER_WARMUP=false
